# ===== Python 缓存与编译产物 =====
__pycache__/
*.py[cod]
*.egg-info/

# ===== 虚拟环境 =====
# 前导 / 锚定仓库根目录，避免 env/ 规则误伤 config/env/ 配置目录
.venv/
/venv/
/env/

# ===== pytest 缓存 =====
.pytest_cache/

# ===== IDE / 编辑器 =====
.idea/
.vscode/

# ===== 测试报告产物（每次运行自动生成，不入库）=====
tests/reports/allure/
tests/reports/allure-report/
tests/reports/assets/
tests/reports/test_report.html
reports/

# ===== 日志文件 =====
*.log

# ===== 被测服务运行时数据库（启动自动重建，不入库）=====
*.db
*.sqlite
*.sqlite3

# ===== CI / 本地生成的 Allure 原始结果 =====
/allure-results/
