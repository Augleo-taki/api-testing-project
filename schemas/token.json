{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "登录令牌",
  "type": "object",
  "required": ["access_token", "token_type"],
  "properties": {
    "access_token": { "type": "string", "minLength": 20 },
    "token_type": { "type": "string", "const": "bearer" }
  },
  "additionalProperties": false
}
